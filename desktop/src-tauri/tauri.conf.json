{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink Counter",
  "version": "2.0.0",
  "identifier": "io.github.wuxinxin27.blinkcounter",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blink Counter — Eye Wellness",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "HealthcareAndFitness",
    "shortDescription": "Real-time blink frequency & eye-wellness desktop companion",
    "longDescription": "Blink Counter uses on-device vision to monitor your blink frequency in real time, remind you to prevent dry eyes, and schedule 20-20-20 far-gaze eye breaks — 100% locally and free.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
